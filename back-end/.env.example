PORT=8000
NODE_ENV=development
# Use MongoDB Atlas or a replica-set URI; follow changes use transactions.
DATA_BASE=mongodb+srv://<username>:<password>@<cluster>/fifood?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:8000/api/v1
# Use the real backend URL in production, for example:
# https://FiFood.onrender.com/api/v1
# and register the same value in Google Cloud Console as the OAuth redirect URI.
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/users/auth/google/callback
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=none
# Set to 1 only when FiFood runs behind one trusted reverse proxy.
TRUST_PROXY=

# Required only for Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for recipe/profile image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for newsletter mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
